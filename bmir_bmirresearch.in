ग्रामीण विकास एवं कृषि आधारित समेकित परिवर्तन कार्यक्रम।", "", "Rural development needs", "Integrated rural development concept", "Review BAMETI correspondence and define pilot scope", "BAMETI and relevant rural development institutions", "ग्रामीण विकास की आवश्यकताएं", "समेकित ग्रामीण विकास अवधारणा", "बामेती पत्र की समीक्षा और पायलट का दायरा तय करना", "बामेती एवं संबंधित संस्थान", "No verified filing"], ["BHAVISHYA NIRMAN", "Education", "Concept for transformative education for children.", "बच्चों की शिक्षा में आमूलचूल परिवर्तन की अवधारणा।", "", "Educational improvement", "Education concept under development", "Review original concept and define evaluation criteria", "Education specialists and schools", "शिक्षा में सुधार", "विकासाधीन शैक्षणिक अवधारणा", "मूल अवधारणा और मूल्यांकन मानदंड की समीक्षा", "शिक्षा विशेषज्ञ एवं विद्यालय", "No verified filing"]];let hi=false;const $=id=>document.getElementById(id);const t=(a,b)=>hi?b:a;const slug=x=>x[0].toLowerCase().replace(/[^a-z0-9]+/g,'-');const sectors=[...new Set(data.map(x=>x[1]))];const labels={'Agriculture':'कृषि','Healthcare':'स्वास्थ्य','Urban safety':'शहरी सुरक्षा','Railways':'रेलवे','Governance':'शासन','Water':'जल','Export':'निर्यात','Defence':'रक्षा','Energy':'ऊर्जा','Education':'शिक्षा','Rural development':'ग्रामीण विकास','Research':'अनुसंधान'};function status(x){let pub=['202631048563','202631058488','202631065492'].includes(x[4]);let joint=['202631065492'].includes(x[4]);return (x[4]?t(x[13]+' application','आवेदन: '+x[13]):t('No verified filing reference','सत्यापित दाखिल संदर्भ उपलब्ध नहीं'))+(pub?t(' · Journal published (screenshot evidence)',' · जर्नल प्रकाशित (स्क्रीनशॉट प्रमाण उपलब्ध)'):'')+(joint?' · Co-inventors: Binod Pandey & Shyam Sundar Mandal':'')+(x[4]==='202631067840'?' · Co-inventors: Binod Pandey & Akash Rajvanshi (inventor-reported; Form 1 pending)':'');}function render(){document.getElementById("published").innerHTML=data.filter(x=>["202631048563","202631058488","202631065492"].includes(x[4])).map(x=>`<p><a href="#project/${slug(x)}">${x[0]}</a> · ${x[4]} · ${status(x)}</p>`).join("");document.querySelectorAll('[data-en]').forEach(e=>e.textContent=e.dataset[hi?'hi':'en']);document.documentElement.lang=hi?'hi':'en';$('lang').textContent=hi?'English':'हिंदी';let old=$('sector').value;$('sector').innerHTML='<option value="">'+t('All sectors','सभी क्षेत्र')+'</option>'+sectors.map(v=>`<option value="${v}">${hi?labels[v]:v}</option>`).join('');$('sector').value=old;let q=$('search').value.toLowerCase();let filtered=data.filter(x=>(!old||x[1]===old)&&x.join(' ').toLowerCase().includes(q));$('count').textContent=filtered.length+' / '+data.length+' '+t('projects','परियोजनाएं');$('cards').innerHTML=filtered.map(x=>`<article class="card"><div class="tag">${hi?labels[x[1]]:x[1]}</div><h3>${x[0]}</h3><p>${x[hi?3:2]}</p><small>${status(x)}</small><br><a class="detail-link" href="#project/${slug(x)}">${t('View project','परियोजना देखें')} →</a></article>`).join('');$('patents').innerHTML=data.filter(x=>x[4]).map(x=>`<article class="card"><strong>${x[0]}</strong><p>${x[4]}${x[0]==='Intelligent Maize Dryer'?'<br>202631056728 (Provisional)':''}</p><small>${status(x)}</small></article>`).join('');detail();}function detail(){let x=data.find(x=>location.hash==='#project/'+slug(x));$('detail').hidden=!x;if(!x)return;let fields=[[t('Problem','समस्या'),x[hi?9:5]],[t('Proposed solution','प्रस्तावित समाधान'),x[hi?10:6]],[t('Validation required','आवश्यक सत्यापन'),x[hi?11:7]],[t('Collaboration sought','अपेक्षित सहयोग'),x[hi?12:8]]];$('detail').innerHTML=`<a href="#portfolio">← ${t('Back to portfolio','पोर्टफोलियो पर लौटें')}</a><h2>${x[0]}</h2><p>${x[hi?3:2]}</p><p><strong>${t('Development status','विकास स्थिति')}:</strong> ${t('Research / concept; prototype and validation status not independently verified.','शोध / अवधारणा; प्रोटोटाइप और सत्यापन की स्थिति स्वतंत्र रूप से प्रमाणित नहीं।')}</p><div class="detail-grid">${fields.map(f=>`<article class="card"><h3>${f[0]}</h3><p>${f[1]}</p></article>`).join('')}</div><h3>${t('Intellectual property','बौद्धिक संपदा')}</h3><p>${status(x)} ${x[4]}</p><p>${t('No patent grant or institutional approval is claimed.','पेटेंट स्वीकृति या संस्थागत अनुमोदन का दावा नहीं है।')}</p><a class="detail-link" href="tel:+918340328914">${t('Contact for collaboration','सहयोग हेतु संपर्क')} · +91 8340 328914</a>`;} $('lang').onclick=()=>{hi=!hi;render()};$('search').oninput=render;$('sector').onchange=render;window.addEventListener('hashchange',()=>{detail();if(!$('detail').hidden)$('detail').scrollIntoView()});render();if(!$('detail').hidden)$('detail').scrollIntoView();</script></html><script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/vce701823e78c4301a35b7e07294d87301792088814092" integrity="sha512-UKNk8GbxkABxKcXYuLkO16EleLGUkcvJWtpSNmExE0Too3ZaFAxTscNWEc1OdAv5/BikHawapSCaiD2XCmp+Bw==" data-cf-beacon='{"version":"2024.11.0","token":"a1582655825b460e8bfac6db9e6689f1","r":1,"spa":2}' crossorigin="anonymous"></script>
