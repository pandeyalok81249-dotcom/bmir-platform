# Environment Configuration
PROJECT_NAME="AI Resume Intelligence Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL / async SQLite for tests)
DATABASE_URL="sqlite+aiosqlite:///./resume_intelligence.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/resume_intelligence"

# Redis Cache / Queue
REDIS_URL="redis://localhost:6379/0"

# AI Provider API Keys
OPENAI_API_KEY=""
OPENAI_DEFAULT_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
GEMINI_DEFAULT_MODEL="gemini-1.5-flash"
PREFERRED_AI_PROVIDER="gemini" # 'gemini' or 'openai'

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Storage
STORAGE_BACKEND="local" # 'local' or 's3'
LOCAL_STORAGE_PATH="./uploads"
S3_BUCKET_NAME=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# CORS
BACKEND_CORS_ORIGINS=["*"]

